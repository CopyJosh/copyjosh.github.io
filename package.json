{
  "name": "expressjs-boilerplate",
  "version": "1.0.0",
  "description": "Lite Frontend boilerplate based on Bootstrap for pure showcase/prototype sites, with Webpack for assets management and Nunjucks as template engine.",
  "scripts": {
    "build": "node scripts/build.cjs",
    "prod": "npm run build",
    "production": "npm run build",
    "dev": "npm run build && node --watch bin/www",
    "watch": "npm run dev",
    "start": "node bin/www",
    "lint": "eslint app.js bin/www routes scripts tests assets/js",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "author": "Adrien Beaudouin",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "sass": "1.106.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "debug": "4.4.3",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "morgan": "^1.9.0",
    "serve-favicon": "^2.4.5",
    "bootstrap": "5.3.8",
    "@popperjs/core": "2.11.8",
    "font-awesome": "4.7.0",
    "ejs": "7.0.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "packageManager": "npm@11.19.1"
}
